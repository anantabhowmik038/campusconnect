{
  "name": "campusconnect",
  "version": "0.1.0",
  "private": true,
  "description": "CampusConnect shared application starter",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "test": "npm run test --workspace backend",
    "docs:generate": "jsdoc --configure jsdoc.json --pedantic"
  },
  "dependencies": {
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "jsdoc": "^4.0.5"
  }
}
